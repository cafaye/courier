# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
courier-*.tar

# Local environment overrides. In production SECRET_KEY_BASE and DATABASE_URL
# come from the environment and config/runtime.exs raises without them, so
# nothing holding a real value belongs in this repository.
.env
.env.*
!.env.example

# Kamal's secrets, and ONLY that.
#
# `config/deploy.yml` names a dozen credentials — DATABASE_URL,
# COURIER_SECRET_BOX_KEY, RESTIC_PASSWORD, the R2 pair — and `kamal init` writes
# their VALUES into `.kamal/secrets` on the operator's machine. Every name in
# that directory is a credential, and `RESTIC_PASSWORD` is the one value that
# makes the entire backup repository readable or not, so an unignored `.kamal/`
# is a `git add -A` away from publishing the key that opens every snapshot.
#
# The trailing slash matters in the other direction: `.kamal/hooks/` is where a
# Kamal 2 pre-deploy hook lives, and a hook is a committed script rather than a
# secret. Ignoring the directory wholesale would make that file invisible to
# `git add`, so the ignore is narrowed to the two files Kamal actually writes.
.kamal/secrets
.kamal/secrets-*

# ElixirLS build artifacts.
.elixir_ls

